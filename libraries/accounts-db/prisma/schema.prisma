datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

model Address {
  id         String    @id @default(cuid())
  userId     String
  city       String?
  country    String?
  isDefault  Boolean   @default(false)
  line1      String?
  line2      String?
  mobile     String?
  postalCode String?
  region     String?
  telephone  String?
  user       User      @relation(fields: [userId], references: [id])
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  updatedAt  DateTime  @updatedAt

  @@map(name: "addreses")
}

model Client {
  id                       String                    @id @default(cuid())
  userId                   String
  type                     ApplicationType?          @default(web)
  approvals                ClientApproval[]
  contacts                 String[]
  description              String?
  grantTypes               GrantType[] // default: authorization_code
  isFirstParty             Boolean                   @default(false)
  jwks                     JWK[]
  jwksUri                  String?
  logoUri                  String?
  name                     String?                   @unique
  policyUri                String?
  publicKeysConfiguration  PublicKeysConfiguration?  @default(local)
  redirectUris             String[]
  responseTypes            ResponseType[] // default: code
  refreshTokenRotationType RefreshTokenRotationType? @default(rotate)
  secret                   String?                   @default(cuid())
  scope                    Scope[]
  softwareId               String?
  softwareVersion          String?
  tosUri                   String?
  tokenEndpointAuthMethod  TokenEndpointAuthMethod?  @default(client_secret_basic)
  uri                      String?
  user                     User                      @relation(fields: [userId], references: [id])
  createdAt                DateTime                  @default(now())
  deletedAt                DateTime?
  updatedAt                DateTime                  @updatedAt

  @@map(name: "clients")
}

model ClientApproval {
  id        String    @id @default(cuid())
  userId    String
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  scopes    Scope[]
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt

  @@unique([userId, clientId])
  @@map(name: "client_approvals")
}

model JWK {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  jwk       Json
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt

  @@map(name: "jwks")
}

model Profile {
  id         String    @id @default(cuid())
  userId     String    @unique
  birthdate  DateTime? // YYYY-MM-DD
  firstName  String?
  gender     Gender?
  locale     String? //en-US or en_US
  lastName   String?
  middleName String?
  nickname   String?
  profile    String?
  picture    String?
  user       User      @relation(fields: [userId], references: [id])
  website    String?
  zoneinfo   String? // America/Los_Angeles
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  updatedAt  DateTime  @updatedAt

  @@map(name: "profiles")
}

model Scope {
  id              String           @id @default(cuid())
  clients         Client[]
  clientApprovals ClientApproval[]
  description     String
  displayName     String
  name            String           @unique
  createdAt       DateTime         @default(now())
  deletedAt       DateTime?
  updatedAt       DateTime         @updatedAt

  @@map(name: "scopes")
}

model User {
  id                  String           @id @default(cuid())
  addresses           Address[]
  clients             Client[]
  clientApprovals     ClientApproval[]
  email               String           @unique
  emailVerified       Boolean?         @default(false)
  profile             Profile?
  phoneNumber         String?
  phoneNumberVerified Boolean?         @default(false)
  password            String
  username            String?          @unique
  createdAt           DateTime         @default(now())
  deletedAt           DateTime?
  updatedAt           DateTime         @updatedAt

  @@map(name: "users")
}

enum ApplicationType {
  browser
  native
  web
}

enum Gender {
  female
  male
}

enum GrantType {
  authorization_code
  client_credentials
  refresh_token
}

enum PublicKeysConfiguration {
  local
  remote
}

enum ResponseType {
  code
}

enum RefreshTokenRotationType {
  rotate
  static
}

enum TokenEndpointAuthMethod {
  client_secret_basic
  none
  private_key_jwt
}
