{
  "name": "@dritelabs/accounts-protobuf",
  "version": "0.0.0",
  "description": "Accounts database module",
  "keywords": [
    "Accounts",
    "database",
    "module"
  ],
  "author": "Guillermo <guillermolopez2529@gmail.com>",
  "homepage": "https://driten.com",
  "license": "ISC",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.mjs",
    "./dist/server": "./dist/server.mjs",
    "./dist/client": "./dist/client.mjs"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/driten-project/accounts.git"
  },
  "scripts": {
    "build": "tsup",
    "gen": "proto-loader-gen-types --longs=String --enums=String --defaults --oneofs --arrays --grpcLib=@grpc/grpc-js --outDir=src/protobuf/ proto/*.proto"
  },
  "bugs": {
    "url": "https://github.com/driten-project/accounts/issues"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.6.7",
    "@grpc/proto-loader": "^0.6.11"
  },
  "devDependencies": {
    "@types/node": "16.11.19",
    "@rushstack/heft": "0.47.0",
    "typescript": "4.5.5",
    "tsup": "5.11.13",
    "grpc-tools": "^1.11.2",
    "grpc_tools_node_protoc_ts": "^5.3.2"
  }
}
