{
  "name": "@driten/accounts-protobuf",
  "version": "0.0.0",
  "description": "Accounts database module",
  "keywords": [
    "Accounts",
    "database",
    "module"
  ],
  "author": "Guillermo <guillermolopez2529@gmail.com>",
  "homepage": "https://driten.com",
  "license": "ISC",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./protobuf/*": "./protobuf/*.js"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/driten-project/accounts.git"
  },
  "scripts": {
    "build": "tsup",
    "generate": "grpc_tools_node_protoc --proto_path=proto --ts_out=grpc_js:./protobuf --js_out=import_style=commonjs,binary:./protobuf/ --grpc_out=grpc_js:./protobuf --plugin=protoc-gen-ts=../../node_modules/.bin/protoc-gen-ts --plugin=protoc-gen-grpc=`which grpc_tools_node_protoc_plugin` ./proto/*.proto"
  },
  "bugs": {
    "url": "https://github.com/driten-project/accounts/issues"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.5.4",
    "google-protobuf": "3.19.4"
  },
  "devDependencies": {
    "@types/google-protobuf": "^3.15.5",
    "grpc-tools": "^1.11.2",
    "grpc_tools_node_protoc_ts": "^5.3.2"
  }
}