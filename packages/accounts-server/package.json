{
  "name": "@dritelabs/accounts-server",
  "version": "0.0.0",
  "description": "Accounts server module",
  "keywords": [
    "accounts",
    "server",
    "module"
  ],
  "author": "Guillermo <guillermolopez2529@gmail.com>",
  "homepage": "https://driten.com",
  "license": "ISC",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "types": "dist/index.d.ts",
  "directories": {
    "lib": "dist",
    "test": "__tests__"
  },
  "files": [
    "dist",
    "config"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/driten-project/accounts.git"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup-node src/index.ts --sourcemap --watch --onSuccess 'node dist/index.mjs'"
  },
  "bugs": {
    "url": "https://github.com/driten-project/accounts/issues"
  },
  "dependencies": {
    "@dritelabs/accounts-db": "*",
    "@dritelabs/accounts-errors": "*",
    "@dritelabs/accounts-protobuf": "*",
    "@dritelabs/accounts-utils": "*",
    "bcrypt": "^5.0.1",
    "memjs": "^1.3.0",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/memjs": "^1.2.4",
    "@types/yup": "^0.29.14",
    "@types/node": "16.11.19",
    "@rushstack/heft": "0.47.0",
    "typescript": "4.8.2",
    "tsup": "6.2.3"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "./dist"
        ]
      }
    }
  }
}