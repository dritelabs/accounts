datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
  output        = "../../../node_modules/.prisma/client"
}

model Address {
  id          String    @id @default(cuid())
  user_id     String
  line1       String?
  line2       String?
  city        String?
  postal_code String?
  country     String?
  telephone   String?
  mobile      String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  user User @relation(fields: [user_id], references: [id])

  @@map(name: "addreses")
}

model Client {
  id                         String                   @id @default(cuid())
  user_id                    String
  application_type           ApplicationType?         @default(web)
  client_uri                 String?
  contacts                   String[]
  description                String?
  grant_types                GrantType[] // default: authorization_code
  is_first_party             Boolean                  @default(false)
  jwks                       Json?
  jwks_uri                   String?
  logo_uri                   String?
  name                       String?                  @unique
  policy_uri                 String?
  redirect_uris              String[]
  secret                     String?                  @default(cuid())
  response_types             ResponseType[] // default: code
  scope                      Scope[]
  software_id                String?
  software_version           String?
  token_endpoint_auth_method TokenEndpointAuthMethod? @default(private_key_jwt)
  tos_uri                    String?
  user                       User                     @relation(fields: [user_id], references: [id])
  created_at                 DateTime                 @default(now())
  updated_at                 DateTime                 @updatedAt
  deleted_at                 DateTime?

  client_approvals ClientApproval[]

  @@map(name: "clients")
}

model ClientApproval {
  id         String    @id @default(cuid())
  user_id    String
  client_id  String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  client Client @relation(fields: [client_id], references: [id])
  user   User   @relation(fields: [user_id], references: [id])


  @@map(name: "client_approvals")
}

model Profile {
  id         String   @id @default(cuid())
  user_id    String   @unique
  first_name String?
  last_name  String?
  telephone  Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@map(name: "profiles")
}

model Scope {
  id           String    @id @default(cuid())
  name         String    @unique
  description  String
  display_name String
  clients      Client[]
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  @@map(name: "scopes")
}

model User {
  id             String    @id @default(cuid())
  username       String?   @unique
  email          String    @unique
  email_verified Boolean?  @default(false)
  password       String
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  clients          Client[]
  client_approvals ClientApproval[]
  profile          Profile?
  addresses        Address[]

  @@map(name: "users")
}

enum TokenEndpointAuthMethod {
  none
  client_secret_basic
  private_key_jwt
}

enum ResponseType {
  code
}

enum GrantType {
  authorization_code
  refresh_token
  client_credentials
}

enum ApplicationType {
  browser
  native
  web
}
